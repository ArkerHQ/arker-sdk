#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

bun ci --cwd "$REPO_ROOT"
uv sync --project "$REPO_ROOT/python" --locked --group dev --extra test

cd "$REPO_ROOT"

(
  cd python
  uv run --locked --group dev ruff check .
  uv run --locked --group dev ruff format --check .
)
./scripts/check-openapi
python3 tests/test_openapi_enforcement.py
# Same split as CI: the SDK suite runs from python/ (where pyproject's
# testpaths keeps the live tests/e2e out), the repo tooling tests run from
# the root. A bare root `pytest` would load no config at all and sweep up
# both plus e2e.
(cd python && uv run --locked --group dev --extra test python -m pytest)
uv run --project python --locked --group dev --extra test python -m pytest tests
(
  cd typescript
  bun run typecheck
  bun run test
)
(
  cd go
  test -z "$(gofmt -l .)" || { gofmt -l .; echo "gofmt: files above need formatting"; exit 1; }
  # vet, not just build: it type-checks test files, which is the only thing
  # that compiles tests/e2e (never run here -- it creates real VMs).
  go vet ./...
  go build ./...
  go test ./tests/unit/ -count=1
  go mod tidy
  git diff --exit-code go.mod go.sum
)
(
  cd cli
  bun run typecheck
  bun run test
)
