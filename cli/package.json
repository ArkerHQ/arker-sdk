{
  "name": "@arker-ai/cli",
  "version": "0.5.0",
  "description": "Command-line client for the Arker virtual computer platform.",
  "type": "module",
  "bin": {
    "arker": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --target=node18",
    "test": "bun run build && bun tests/cli.ts && bun tests/cli-pty.ts",
    "test:e2e": "bun run build && bun tests/cli-e2e.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "keywords": [
    "arker",
    "cli",
    "vm",
    "sandbox",
    "agent"
  ],
  "license": "Apache-2.0",
  "homepage": "https://arker.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArkerHQ/arker-sdk.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/ArkerHQ/arker-sdk/issues",
  "dependencies": {
    "@arker-ai/sdk": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "ws": "^8.21.0"
  }
}
