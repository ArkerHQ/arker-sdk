{
  "name": "@arker-ai/sdk",
  "version": "1.3.0",
  "description": "TypeScript SDK for Arker virtual machines.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arker": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./daytona": {
      "types": "./dist/daytona.d.ts",
      "import": "./dist/daytona.js",
      "require": "./dist/daytona.cjs"
    },
    "./e2b": {
      "types": "./dist/e2b.d.ts",
      "import": "./dist/e2b.js",
      "require": "./dist/e2b.cjs"
    },
    "./e2b-code-interpreter": {
      "types": "./dist/e2b-code-interpreter.d.ts",
      "import": "./dist/e2b-code-interpreter.js",
      "require": "./dist/e2b-code-interpreter.cjs"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "import": "./dist/modal.js",
      "require": "./dist/modal.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "bun run build:sdk && ../scripts/build-legacy-cli",
    "build:sdk": "bun run generate:validators && tsup src/index.ts src/daytona.ts src/e2b.ts src/e2b-code-interpreter.ts src/modal.ts --format esm,cjs --dts --clean --target=node18",
    "check:api-types": "openapi-typescript ../openapi.json --default-non-nullable false -o src/generated/api-types.ts --check",
    "example:ios-qa": "bun examples/ios-qa.ts",
    "generate:api-types": "openapi-typescript ../openapi.json --default-non-nullable false -o src/generated/api-types.ts",
    "smoke": "bun tests/conformance/fork-run-sync.ts",
    "test": "bun run generate:validators && bun test tests/typed-errors.test.ts tests/execution-model.test.ts tests/api-keys.test.ts tests/compat.test.ts && bun tests/unit.ts && bun run build && bun tests/http2.ts",
    "test:compat": "bun test tests/compat.test.ts",
    "test:e2b-live": "bun tests/e2b-live.ts && bun tests/e2b-lifecycle-live.ts && bun tests/e2b-access-live.ts",
    "test:e2b-code-interpreter-live": "bun tests/e2b-code-interpreter-live.ts",
    "test:daytona-live": "bun tests/daytona-live.ts && bun tests/daytona-lifecycle-live.ts && bun tests/daytona-access-live.ts",
    "typecheck": "bun run generate:validators && tsc -p tsconfig.test.json",
    "prepublishOnly": "bun run build",
    "generate:validators": "bun scripts/generate-error-validators.ts",
    "test:modal-live": "bun tests/modal-live.ts && bun tests/modal-lifecycle-live.ts",
    "test:run-live": "bun tests/run-live.ts"
  },
  "keywords": [
    "arker",
    "vm",
    "sandbox",
    "agent",
    "code-execution"
  ],
  "license": "Apache-2.0",
  "homepage": "https://arker.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArkerHQ/arker-sdk.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/ArkerHQ/arker-sdk/issues",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "peerDependencies": {
    "@daytonaio/sdk": "^0.232.0",
    "e2b": "^2.0.0",
    "modal": "^0.11.0"
  },
  "peerDependenciesMeta": {
    "@daytonaio/sdk": {
      "optional": true
    },
    "e2b": {
      "optional": true
    },
    "modal": {
      "optional": true
    }
  },
  "dependencies": {
    "dockerfile-ast": "^0.7.1",
    "tar": "^7.5.22",
    "ws": "^8.21.0"
  }
}
