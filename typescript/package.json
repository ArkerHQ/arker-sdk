{
  "name": "@arker-ai/sdk",
  "version": "1.2.7",
  "description": "TypeScript SDK for the Arker virtual computer platform — spawn sandboxed VMs, run code, sync files.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arker": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./daytona": {
      "types": "./dist/daytona.d.ts",
      "import": "./dist/daytona.js",
      "require": "./dist/daytona.cjs"
    },
    "./e2b": {
      "types": "./dist/e2b.d.ts",
      "import": "./dist/e2b.js",
      "require": "./dist/e2b.cjs"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "import": "./dist/modal.js",
      "require": "./dist/modal.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "bun run build:sdk && ../scripts/build-legacy-cli",
    "build:sdk": "tsup src/index.ts src/daytona.ts src/e2b.ts src/modal.ts --format esm,cjs --dts --clean --target=node18",
    "check:api-types": "openapi-typescript ../openapi.json --default-non-nullable false -o src/generated/api-types.ts --check",
    "demo": "bun tests/demo.ts",
    "example:ios-qa": "bun examples/ios-qa.ts",
    "generate:api-types": "openapi-typescript ../openapi.json --default-non-nullable false -o src/generated/api-types.ts",
    "smoke": "bun tests/conformance/fork-run-sync.ts",
    "test": "bun tests/unit.ts && bun tests/compat.ts && bun run build && bun tests/http2.ts",
    "test:compat": "bun tests/compat.ts",
    "test:compat-live": "bun tests/compat-live.ts",
    "test:compat-fallback-live": "bun tests/compat-fallback-live.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "arker",
    "vm",
    "sandbox",
    "agent",
    "code-execution"
  ],
  "license": "Apache-2.0",
  "homepage": "https://arker.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArkerHQ/arker-sdk.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/ArkerHQ/arker-sdk/issues",
  "devDependencies": {
    "@computesdk/daytona": "^1.7.30",
    "@computesdk/e2b": "^1.7.51",
    "@computesdk/modal": "^1.9.3",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "computesdk": "^4.1.3",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@computesdk/daytona": "^1.7.30",
    "@computesdk/e2b": "^1.7.51",
    "@computesdk/modal": "^1.9.3",
    "computesdk": "^4.1.3"
  },
  "peerDependenciesMeta": {
    "@computesdk/daytona": {
      "optional": true
    },
    "@computesdk/e2b": {
      "optional": true
    },
    "@computesdk/modal": {
      "optional": true
    },
    "computesdk": {
      "optional": true
    }
  },
  "dependencies": {
    "dockerfile-ast": "^0.7.1",
    "tar": "^7.5.22",
    "ws": "^8.21.0"
  }
}
