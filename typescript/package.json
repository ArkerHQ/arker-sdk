{
  "name": "@arker-ai/sdk",
  "version": "1.2.8",
  "description": "TypeScript SDK for the Arker virtual computer platform \u2014 spawn sandboxed VMs, run code, sync files.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arker": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./daytona": {
      "types": "./dist/daytona.d.ts",
      "import": "./dist/daytona.js",
      "require": "./dist/daytona.cjs"
    },
    "./e2b": {
      "types": "./dist/e2b.d.ts",
      "import": "./dist/e2b.js",
      "require": "./dist/e2b.cjs"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "import": "./dist/modal.js",
      "require": "./dist/modal.cjs"
    },
    "./blaxel": {
      "types": "./dist/blaxel.d.ts",
      "import": "./dist/blaxel.js",
      "require": "./dist/blaxel.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "bun run build:sdk && ../scripts/build-legacy-cli",
    "build:sdk": "bun run generate:validators && tsup src/index.ts src/daytona.ts src/e2b.ts src/modal.ts src/blaxel.ts --format esm,cjs --dts --clean --target=node18",
    "check:api-types": "openapi-typescript ../openapi.json --default-non-nullable false -o src/generated/api-types.ts --check",
    "demo": "bun tests/demo.ts",
    "example:ios-qa": "bun examples/ios-qa.ts",
    "generate:api-types": "openapi-typescript ../openapi.json --default-non-nullable false -o src/generated/api-types.ts",
    "smoke": "bun tests/conformance/fork-run-sync.ts",
    "test": "bun run generate:validators && bun test tests/typed-errors.test.ts && bun run test:port && bun tests/unit.ts && bun tests/compat.ts && bun tests/compat-router.ts && bun tests/compat-coverage.ts && bun run build && bun tests/http2.ts",
    "test:port": "bun build tests/port-stream.test.ts --target=node --external=ws --outfile=node_modules/.cache/port-tests.cjs --format=cjs && node node_modules/.cache/port-tests.cjs && bun test tests/port-stream.test.ts && bun run test:private-fetch && bun run test:e2b-handles",
    "test:e2b-handles": "bun build tests/e2b-command-handle.test.ts tests/e2b-lifecycle.test.ts --target=node --external=e2b --outdir=node_modules/.cache/e2b-tests --format=cjs && node node_modules/.cache/e2b-tests/e2b-command-handle.test.js && node node_modules/.cache/e2b-tests/e2b-lifecycle.test.js",
    "test:private-fetch": "bun build tests/private-fetch.test.ts --target=node --outfile=node_modules/.cache/private-fetch-tests.cjs --format=cjs && node node_modules/.cache/private-fetch-tests.cjs",
    "coverage:compat": "bun scripts/compat-coverage.ts",
    "test:compat": "bun tests/compat.ts",
    "test:router": "bun tests/compat-router.ts",
    "test:compat-live": "bun tests/compat-live.ts",
    "test:compat-fallback-live": "bun tests/compat-fallback-live.ts",
    "test:compat-equivalence-live": "bun tests/compat-equivalence-live.ts",
    "test:compat-policy-live": "bun tests/compat-policy-live.ts",
    "test:compat-blaxel-live": "bun tests/compat-blaxel-live.ts",
    "typecheck": "bun run generate:validators && tsc -p tsconfig.test.json",
    "prepublishOnly": "bun run build",
    "generate:validators": "bun scripts/generate-compat-process.ts && bun scripts/generate-error-validators.ts"
  },
  "keywords": [
    "arker",
    "vm",
    "sandbox",
    "agent",
    "code-execution"
  ],
  "license": "Apache-2.0",
  "homepage": "https://arker.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArkerHQ/arker-sdk.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/ArkerHQ/arker-sdk/issues",
  "devDependencies": {
    "e2b": "2.56.0",
    "@daytona/sdk": "0.224.1",
    "modal": "0.11.1",
    "@blaxel/core": "^0.3.30",
    "@computesdk/daytona": "^1.7.43",
    "@computesdk/e2b": "^1.7.62",
    "@computesdk/modal": "^1.9.19",
    "@computesdk/blaxel": "^1.6.33",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "computesdk": "^4.1.12",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "peerDependencies": {
    "e2b": "^2.56.0",
    "@daytona/sdk": "^0.224.1",
    "modal": "^0.11.1",
    "@blaxel/core": "^0.3.30",
    "@computesdk/daytona": "^1.7.43",
    "@computesdk/e2b": "^1.7.62",
    "@computesdk/modal": "^1.9.19",
    "@computesdk/blaxel": "^1.6.33",
    "computesdk": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "e2b": { "optional": true },
    "@daytona/sdk": { "optional": true },
    "modal": { "optional": true },
    "@blaxel/core": {
      "optional": true
    },
    "@computesdk/daytona": {
      "optional": true
    },
    "@computesdk/e2b": {
      "optional": true
    },
    "@computesdk/modal": {
      "optional": true
    },
    "@computesdk/blaxel": {
      "optional": true
    },
    "computesdk": {
      "optional": true
    }
  },
  "dependencies": {
    "dockerfile-ast": "^0.7.1",
    "tar": "^7.5.22",
    "ws": "^8.21.0"
  }
}
